  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "typebox": "^1.4.6",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labenamata/pacc-bridge.git"
  },
